SIM ?= icarus
TOPLEVEL_LANG ?= verilog

VERILOG_SOURCES += $(PWD)/../rtl/ca_cell.v
VERILOG_SOURCES += $(PWD)/../rtl/ca_grid.v
VERILOG_SOURCES += $(PWD)/../rtl/ca_cell_rule.v
VERILOG_SOURCES += $(PWD)/../rtl/ca_grid_rule.v
VERILOG_SOURCES += $(PWD)/../rtl/uart_tx.v
VERILOG_SOURCES += $(PWD)/../rtl/uart_rx.v
VERILOG_SOURCES += $(PWD)/../rtl/seed_loader.v
VERILOG_SOURCES += $(PWD)/../rtl/rule_loader.v
VERILOG_SOURCES += $(PWD)/../rtl/grid_streamer.v
VERILOG_SOURCES += $(PWD)/../rtl/cellnet_top.v
TOPLEVEL = cellnet_top
MODULE = test_link_speed

# CPB is the clocks-per-bit divider under test. It goes to the DUT as a
# parameter and to the testbench through the environment, so both ends
# of the wire are driven from one number. 234 is the deployed 115200.
CPB ?= 234
export CPB

COMPILE_ARGS += -Pcellnet_top.ROWS=16
COMPILE_ARGS += -Pcellnet_top.COLS=16
COMPILE_ARGS += -Pcellnet_top.CLKS_PER_BIT=$(CPB)
COMPILE_ARGS += -Pcellnet_top.GEN_DIV=2700000
COMPILE_ARGS += -Pcellnet_top.TIMEOUT_CLKS=2700000
COMPILE_ARGS += -Pcellnet_top.RULE_CFG=1

# One build directory per rate. cocotb skips a rebuild when only
# Makefile parameters change, so a shared directory would silently run
# the previous rate's binary against this rate's testbench.
SIM_BUILD = sim_build_link_speed_$(CPB)

include $(shell cocotb-config --makefiles)/Makefile.sim
