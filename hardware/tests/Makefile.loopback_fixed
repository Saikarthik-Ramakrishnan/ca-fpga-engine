SIM ?= icarus
TOPLEVEL_LANG ?= verilog

VERILOG_SOURCES += $(PWD)/../rtl/ca_cell.v
VERILOG_SOURCES += $(PWD)/../rtl/ca_grid.v
VERILOG_SOURCES += $(PWD)/../rtl/ca_cell_rule.v
VERILOG_SOURCES += $(PWD)/../rtl/ca_grid_rule.v
VERILOG_SOURCES += $(PWD)/../rtl/uart_tx.v
VERILOG_SOURCES += $(PWD)/../rtl/uart_rx.v
VERILOG_SOURCES += $(PWD)/../rtl/seed_loader.v
VERILOG_SOURCES += $(PWD)/../rtl/rule_loader.v
VERILOG_SOURCES += $(PWD)/../rtl/grid_streamer.v
VERILOG_SOURCES += $(PWD)/../rtl/cellnet_top.v
TOPLEVEL = cellnet_top
MODULE = test_cellnet_loopback

# Identical to Makefile.loopback except RULE_CFG=0: the smaller fabric with
# Conway welded into the gates and no rule_loader. Running the same
# testbench against both builds is what makes "RULE_CFG picks the fabric,
# nothing else changes" a checked claim rather than a comment.
COMPILE_ARGS += -Pcellnet_top.ROWS=8
COMPILE_ARGS += -Pcellnet_top.COLS=8
COMPILE_ARGS += -Pcellnet_top.CLKS_PER_BIT=4
COMPILE_ARGS += -Pcellnet_top.GEN_DIV=170
COMPILE_ARGS += -Pcellnet_top.TIMEOUT_CLKS=2000
COMPILE_ARGS += -Pcellnet_top.RULE_CFG=0

SIM_BUILD = sim_build_loopback_fixed

include $(shell cocotb-config --makefiles)/Makefile.sim
