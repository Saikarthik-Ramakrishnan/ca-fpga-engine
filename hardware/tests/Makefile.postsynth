SIM ?= icarus
TOPLEVEL_LANG ?= verilog

# Post-synthesis verification: instead of simulating the RTL, simulate the
# ACTUAL gate-level netlist that synth_gowin -nowidelut produced, wired up
# with Gowin's own primitive simulation models. If the real mapped gates
# pass the same tests the RTL passes, the optimization provably didn't
# change behavior.
#
# Generate the netlist first:
#   cd hardware/synth && python3 emit_netlist.py
# Gowin's primitive models ship inside yosys, and where that is depends
# on how yosys was installed: /usr/share/yosys under oss-cad-suite, a
# Cellar path under Homebrew. Ask yosys instead of guessing. Override
# GOWIN_CELLS_SIM to point somewhere else.
YOSYS_DATDIR ?= $(shell yosys-config --datdir 2>/dev/null || echo /usr/share/yosys)
GOWIN_CELLS_SIM ?= $(YOSYS_DATDIR)/gowin/cells_sim.v

VERILOG_SOURCES += $(GOWIN_CELLS_SIM)
VERILOG_SOURCES += $(PWD)/../synth/build/ca_grid_netlist.v

TOPLEVEL = ca_grid
MODULE = test_ca_grid

# own build dir: suites sharing sim_build serve each other stale binaries
# (cocotb only rebuilds when sources change, not when the Makefile does)
SIM_BUILD = sim_build_postsynth

include $(shell cocotb-config --makefiles)/Makefile.sim
