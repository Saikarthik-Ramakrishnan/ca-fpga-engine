SIM ?= icarus
TOPLEVEL_LANG ?= verilog

VERILOG_SOURCES += $(PWD)/../rtl/ca_cell_rule.v
VERILOG_SOURCES += $(PWD)/../rtl/ca_grid_rule.v
VERILOG_SOURCES += $(PWD)/../rtl/uart_tx.v
VERILOG_SOURCES += $(PWD)/../rtl/uart_rx.v
VERILOG_SOURCES += $(PWD)/../rtl/seed_loader.v
VERILOG_SOURCES += $(PWD)/../rtl/rule_loader.v
VERILOG_SOURCES += $(PWD)/../rtl/grid_streamer.v
VERILOG_SOURCES += $(PWD)/../rtl/cellnet_top.v
TOPLEVEL = cellnet_top
MODULE = test_cellnet_rules

# sim-scale parameters: identical to Makefile.loopback so the wire helpers
# imported from test_cellnet_loopback.py stay valid. RULE_CFG=1 is the
# default; named here because it is the whole point of this suite.
COMPILE_ARGS += -Pcellnet_top.ROWS=8
COMPILE_ARGS += -Pcellnet_top.COLS=8
COMPILE_ARGS += -Pcellnet_top.CLKS_PER_BIT=4
COMPILE_ARGS += -Pcellnet_top.GEN_DIV=170
COMPILE_ARGS += -Pcellnet_top.TIMEOUT_CLKS=2000
COMPILE_ARGS += -Pcellnet_top.RULE_CFG=1

SIM_BUILD = sim_build_rules

include $(shell cocotb-config --makefiles)/Makefile.sim
