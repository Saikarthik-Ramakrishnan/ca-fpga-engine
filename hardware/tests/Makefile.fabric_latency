SIM ?= icarus
TOPLEVEL_LANG ?= verilog

VERILOG_SOURCES += $(PWD)/../rtl/ca_cell.v
VERILOG_SOURCES += $(PWD)/../rtl/ca_grid.v
VERILOG_SOURCES += $(PWD)/../rtl/ca_cell_rule.v
VERILOG_SOURCES += $(PWD)/../rtl/ca_grid_rule.v
VERILOG_SOURCES += $(PWD)/../rtl/uart_tx.v
VERILOG_SOURCES += $(PWD)/../rtl/uart_rx.v
VERILOG_SOURCES += $(PWD)/../rtl/seed_loader.v
VERILOG_SOURCES += $(PWD)/../rtl/rule_loader.v
VERILOG_SOURCES += $(PWD)/../rtl/grid_streamer.v
VERILOG_SOURCES += $(PWD)/../rtl/cellnet_top.v
TOPLEVEL = cellnet_top
MODULE = test_fabric_latency

# GEN_DIV=1: the pacer never holds the grid, so the rule runs every clock.
# That is the fabric's own generation rate, the number the laptop
# comparison needs. CLKS_PER_BIT only sets how fast the seed arrives.
ROWS ?= 16
COLS ?= 16
COMPILE_ARGS += -Pcellnet_top.ROWS=$(ROWS)
COMPILE_ARGS += -Pcellnet_top.COLS=$(COLS)
COMPILE_ARGS += -Pcellnet_top.CLKS_PER_BIT=4
COMPILE_ARGS += -Pcellnet_top.GEN_DIV=1
COMPILE_ARGS += -Pcellnet_top.TIMEOUT_CLKS=2000
COMPILE_ARGS += -Pcellnet_top.RULE_CFG=1
export CELLNET_ROWS := $(ROWS)
export CELLNET_COLS := $(COLS)

# one build directory per size: cocotb does not rebuild when only
# parameters change, and a shared directory would run the other size
SIM_BUILD = sim_build_fabric_latency_$(ROWS)x$(COLS)

include $(shell cocotb-config --makefiles)/Makefile.sim
